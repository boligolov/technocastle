---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t, type Lang, languages } from '../../../i18n/utils';
import { getCollection } from 'astro:content';

export async function getStaticPaths({ paginate }: { paginate: Function }) {
  const allProjects = await getCollection('projects');
  const langs = Object.keys(languages) as Lang[];

  return langs.flatMap(lang => {
    const filtered = allProjects
      .filter(p => p.data.lang === lang)
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

    return paginate(filtered, {
      params: { lang },
      pageSize: 10,
    });
  });
}

const { page } = Astro.props;
const lang = Astro.params.lang as Lang;
const i = t(lang);

const pageLabel = i.home.pageOf
  .replace('{current}', String(page.currentPage))
  .replace('{total}', String(page.lastPage));
---

<BaseLayout title={page.currentPage === 1 ? i.projects.title : `${i.projects.title} — ${pageLabel}`} lang={lang}>
  <header class="page-header">
    <h1>{i.projects.title}</h1>
    <p>{i.projects.subtitle}</p>
  </header>

  <div class="project-list">
    {page.data.map((project, idx) => {
      const num = String((page.currentPage - 1) * 10 + idx).padStart(2, '0');
      return (
        <article class="project-item">
          <div class="project-number">{num}</div>
          <div class="project-body">
            <div class="project-tags">
              {project.data.tags.map(tag => (
                <span class="project-tag">{tag}</span>
              ))}
            </div>
            <a href={`/${lang}/projects/${project.data.projectSlug}`} class="project-title-link">
              <h2>{project.data.title}</h2>
            </a>
            <p class="project-excerpt">{project.data.description}</p>
            <a href={`/${lang}/projects/${project.data.projectSlug}`} class="project-read">{i.home.readMore} &rarr;</a>
          </div>
          {project.data.image && (
            <img class="project-image" src={project.data.image} alt={project.data.title} loading="lazy" />
          )}
        </article>
      );
    })}
  </div>

  {page.lastPage > 1 && (
    <nav class="pagination">
      {page.url.prev ? (
        <a href={page.url.prev} class="pagination-link prev">&larr; {i.home.prevPage}</a>
      ) : (
        <span class="pagination-link prev disabled">&larr; {i.home.prevPage}</span>
      )}
      <span class="pagination-current">{pageLabel}</span>
      {page.url.next ? (
        <a href={page.url.next} class="pagination-link next">{i.home.nextPage} &rarr;</a>
      ) : (
        <span class="pagination-link next disabled">{i.home.nextPage} &rarr;</span>
      )}
    </nav>
  )}
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .page-header h1 { margin-bottom: 0.3em; }

  .project-list {
    display: flex;
    flex-direction: column;
  }

  .project-item {
    display: flex;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
    align-items: flex-start;
  }

  .project-item:last-child { border-bottom: none; }

  .project-number {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    padding-top: 0.3rem;
    flex-shrink: 0;
    width: 28px;
  }

  .project-body { flex: 1; min-width: 0; }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.4rem;
  }

  .project-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 0.15em 0.5em;
  }

  .project-title-link {
    text-decoration: none;
    color: var(--text);
  }

  .project-title-link:hover { color: var(--accent); }

  .project-title-link h2 {
    font-size: 1.2rem;
    margin-bottom: 0.3em;
  }

  .project-excerpt {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: 0.92rem;
    color: var(--text-secondary);
    margin-bottom: 0.5em;
  }

  .project-read {
    font-size: 0.85rem;
    font-weight: 500;
  }

  .project-image {
    width: 140px;
    height: 90px;
    object-fit: cover;
    flex-shrink: 0;
    order: 1;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .pagination-link {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s;
  }

  .pagination-link:hover { color: var(--accent-hover); }
  .pagination-link.disabled { color: var(--text-muted); pointer-events: none; }
  .pagination-current { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); }

  @media (max-width: 768px) {
    .project-number { display: none; }
    .project-item { flex-direction: column; gap: 0.8rem; }
    .project-image { width: 100%; height: 160px; order: 0; }
  }
</style>
