---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, internalHref, withTrailingSlash, type Lang, languages } from '../../i18n/utils';
import { schema } from '../../utils/schema';
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPathsOptions, Page } from 'astro';
import { Image } from 'astro:assets';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const allItems = await getCollection('latest');
  const langs = Object.keys(languages) as Lang[];
  const pageSize = 10;
  // Page counts per language: a paginated page may not exist in every language
  const pageCounts = Object.fromEntries(langs.map(l => [
    l, Math.max(1, Math.ceil(allItems.filter(item => item.data.lang === l).length / pageSize)),
  ]));

  return langs.flatMap(lang => {
    const filtered = allItems
      .filter(item => item.data.lang === lang)
      .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

    return paginate(filtered, {
      params: { lang },
      props: { pageCounts },
      pageSize,
    });
  });
}

interface Props {
  page: Page<CollectionEntry<'latest'>>;
  pageCounts: Record<Lang, number>;
}

const { page, pageCounts } = Astro.props;
const lang = Astro.params.lang as Lang;
const i = t(lang);

const pageLabel = i.home.pageOf
  .replace('{current}', String(page.currentPage))
  .replace('{total}', String(page.lastPage));

const alternateLangs = (Object.keys(languages) as Lang[])
  .filter(l => pageCounts[l] >= page.currentPage);

const ld = schema(Astro.site, lang);
const jsonLd = page.currentPage === 1 ? [ld.website(), ld.author()] : [];
---

<BaseLayout title={page.currentPage === 1 ? i.nav.home : `${i.home.latest} — ${pageLabel}`} lang={lang} alternateLangs={alternateLangs} jsonLd={jsonLd}>
  {page.currentPage === 1 && (
    <section class="hero">
      {i.home.greeting && <p class="hero-greeting">{i.home.greeting}</p>}
      <h1>{i.home.title}</h1>
      {i.home.quote && <blockquote class="hero-quote">{i.home.quote}</blockquote>}
    </section>
  )}

  <section class="intro">
    <h2>{i.home.latest}</h2>
    <div class="card-list">
      {page.data.map(item => (
        <article class="card">
          <div class="card-body">
            <div class="card-tags">
              {item.data.tags.map(tag => (
                <span class="card-tag">{tag}</span>
              ))}
            </div>
            <h3>{item.data.title}</h3>
            <p>{item.data.description}</p>
            <a href={internalHref(item.data.link)} class="card-link">{i.home.readMore} &rarr;</a>
          </div>
          {item.data.image && (
            <Image class="card-image" src={item.data.image} alt={item.data.title} widths={[160, 320, 480, 800]} sizes="(max-width: 768px) 100vw, 160px" />
          )}
        </article>
      ))}
    </div>

    {page.lastPage > 1 && (
      <nav class="pagination">
        {page.url.prev ? (
          <a href={withTrailingSlash(page.url.prev)} class="pagination-link prev">&larr; {i.home.prevPage}</a>
        ) : (
          <span class="pagination-link prev disabled">&larr; {i.home.prevPage}</span>
        )}
        <span class="pagination-current">{pageLabel}</span>
        {page.url.next ? (
          <a href={withTrailingSlash(page.url.next)} class="pagination-link next">{i.home.nextPage} &rarr;</a>
        ) : (
          <span class="pagination-link next disabled">{i.home.nextPage} &rarr;</span>
        )}
      </nav>
    )}
  </section>
</BaseLayout>

<style>
  .hero {
    border-bottom: 1px solid var(--border);
  }

  .hero-greeting {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent);
    margin-bottom: 0.3rem;
  }

  .hero h1 {
    font-size: 3rem;
    letter-spacing: -0.03em;
    margin-bottom: 0.4em;
  }

  .hero-quote {
    font-size: 1.1rem;
    color: var(--text-secondary);
    max-width: 62ch;
    line-height: 1.6;
    border-left: none;
    padding-left: 0;
    margin: 0;
  }

  .intro {
    margin-top: 1rem;
    margin-bottom: 3rem;
  }

  .card-list {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 1.2rem;
  }

  .card {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--border);
    padding: 1.5rem 0;
  }

  .card:last-child {
    border-bottom: none;
  }

  .card-body {
    flex: 1;
    min-width: 0;
  }

  .card-image {
    width: 160px;
    height: 100px;
    object-fit: cover;
    object-position: top;
    flex-shrink: 0;
    order: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.5rem;
  }

  .card-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    border: 1px solid var(--border);
    padding: 0.15em 0.5em;
  }

  .card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.3em;
  }

  .card p {
    font-size: 0.88rem;
    margin-bottom: 0.6em;
  }

  .card-link {
    font-size: 0.85rem;
    font-weight: 500;
  }

  /* Pagination */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .pagination-link {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s;
  }

  .pagination-link:hover {
    color: var(--accent-hover);
  }

  .pagination-link.disabled {
    color: var(--text-muted);
    pointer-events: none;
  }

  .pagination-current {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .hero h1 { font-size: 2.2rem; }
    .card { flex-direction: column; gap: 0.8rem; }
    .card-image { width: 100%; height: 180px; order: 0; }
  }
</style>
